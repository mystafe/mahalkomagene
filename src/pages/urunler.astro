---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import { business } from '../config/business';

import mezeTezgahi from '../assets/images/mahal-komagene-meze-tezgahi.jpeg';
import icMekanTezgah from '../assets/images/mahal-komagene-ic-mekan-tezgah.jpeg';

const kategoriler = [
  {
    id: 'cig-kofte',
    ad: 'Çiğ Köfte',
    etiket: 'Tezgah · Self servis',
    gorsel: mezeTezgahi,
    alt: "Mahal Komagene'nin taze domates, limon, yeşillik ve soslarla hazırlanmış self servis çiğ köfte tezgahı",
    metin:
      'Etsiz çiğ köftemizin yanında tezgahımızda taze yeşillik, garnitür ve sos seçenekleri sizi bekliyor. Self servis düzenimizle porsiyonunuzu istediğiniz gibi hazırlatabilirsiniz.',
  },
  {
    id: 'meze',
    ad: 'Mezeler',
    etiket: 'Tezgah · Meze',
    gorsel: icMekanTezgah,
    alt: 'Mahal Komagene tezgahında sıralı meze kapları ve taze garnitür çeşitleri',
    metin:
      'Tezgahımızda günlük hazırlanan meze çeşitlerimiz mevcut. Çiğ köftenizin yanına ya da tek başına alabilirsiniz.',
  },
  {
    id: 'tatli',
    ad: 'Tatlılar',
    etiket: 'Tezgah · Tatlı',
    gorsel: null,
    alt: '',
    metin: '',
  },
];
---

<BaseLayout
  title="Ürünler | Çiğ Köfte, Meze ve Tatlı – Mahal Komagene"
  description="Mahal Komagene İldem'de çiğ köfte, meze ve tatlı kategorilerinde servis yapar. Ürün kategorilerimize göz atın, tezgahımıza uğrayın."
>
  <PageHead
    etiket="Ürünler · Tezgah"
    no="03 kategori"
    lead={`Üç ana kategoride servis yapıyoruz. Tezgahımız her gün ${business.openingHours.displayShort} arası açık; gelin, seçin, tadına bakın.`}
  >
    <Fragment slot="baslik">Çiğ Köfte,{' '}<br /><span class="vurgu">Meze ve Tatlı</span></Fragment>
    <nav slot="sag" class="atla" aria-label="Kategoriler">
      {
        kategoriler.map((k, i) => (
          <a href={`#${k.id}`} class="kunye">
            <b>{String(i + 1).padStart(2, '0')}</b> {k.ad}
          </a>
        ))
      }
    </nav>
  </PageHead>

  <div class="kap kategoriler">
    {
      kategoriler.map((k, i) => (
        <article
          class:list={['kategori', { ters: i % 2 === 1 }]}
          id={k.id}
          aria-labelledby={`${k.id}-baslik`}
        >
          {k.gorsel ? (
            <figure class="kadraj kategori-gorsel" data-reveal="perde">
              <Picture
                src={k.gorsel}
                widths={[480, 768, 1080, 1400]}
                sizes="(min-width: 1000px) 56vw, 92vw"
                formats={['avif', 'webp']}
                width={1200}
                alt={k.alt}
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : 'auto'}
              />
              <figcaption class="kadraj-etiket">
                <b>{String(i + 1).padStart(2, '0')}</b> {k.etiket}
              </figcaption>
            </figure>
          ) : (
            <div class="kategori-gorsel kategori-bos" role="img" aria-label="Tatlı kategorisi" data-reveal="perde">
              <span class="kategori-bos-yazi display" aria-hidden="true">Tatlı</span>
              <span class="kunye kategori-bos-not">Tezgah · Tatlı</span>
            </div>
          )}

          <div class="kategori-metin">
            <span class="kategori-no display" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h2 id={`${k.id}-baslik`} class="d-m" data-reveal>{k.ad}</h2>
            <p data-reveal style="--d:1">
              {k.id === 'tatli' ? (
                <>
                  Tatlı çeşitlerimiz tezgahımızda. Güncel çeşitler için bize uğrayabilir ya da{' '}
                  <a class="ulink" href={business.phone.href} data-olay="click_call">telefonla sorabilirsiniz</a>.
                </>
              ) : (
                k.metin
              )}
            </p>
            <span class="kunye" data-reveal style="--d:2">{k.etiket}</span>
          </div>
        </article>
      ))
    }
  </div>

</BaseLayout>

<style>
  .atla {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }
  .atla a {
    color: var(--fg);
    text-decoration: none;
    padding-block: 0.4rem;
    border-bottom: 1px solid var(--line-strong);
    transition: border-color 0.3s;
  }
  .atla a:hover {
    border-color: var(--ember);
  }

  .kategoriler {
    display: grid;
  }
  .kategori {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    padding-block: clamp(2.5rem, 6vw, 5rem);
    border-top: 1px solid var(--line);
    scroll-margin-top: var(--hdr-h);
  }
  @media (min-width: 1000px) {
    .kategori {
      grid-template-columns: 1.4fr 1fr;
      align-items: end;
    }
    .kategori.ters {
      grid-template-columns: 1fr 1.4fr;
    }
    .kategori.ters .kategori-gorsel {
      order: 2;
    }
  }
  .kategori-gorsel {
    aspect-ratio: 4 / 5;
  }
  @media (min-width: 640px) {
    .kategori-gorsel {
      aspect-ratio: 3 / 2;
    }
  }
  .kategori-bos {
    position: relative;
    display: grid;
    place-items: center;
    background:
      radial-gradient(120% 90% at 30% 20%, rgb(var(--ember-rgb) / 0.16), transparent 60%),
      var(--bg-raise);
    border: 1px solid var(--line);
    overflow: hidden;
  }
  .kategori-bos-yazi {
    font-size: clamp(6rem, 20vw, 15rem);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px var(--line-strong);
  }
  .kategori-bos-not {
    position: absolute;
    left: 14px;
    bottom: 14px;
  }

  .kategori-metin {
    display: grid;
    gap: 1rem;
    align-content: end;
    justify-items: start;
  }
  .kategori-no {
    font-size: clamp(4rem, 9vw, 7rem);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px var(--ember);
  }
  .kategori-metin p {
    color: var(--fg-dim);
    max-width: 30rem;
    font-size: 1.08rem;
  }


</style>
