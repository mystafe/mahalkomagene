---
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';

import disCephe from '../assets/images/mahal-komagene-dis-cephe.jpeg';
import disCepheKose from '../assets/images/mahal-komagene-dis-cephe-kose.jpeg';
import aksamGorunum from '../assets/images/mahal-komagene-aksam-gorunum.jpeg';
import giris from '../assets/images/mahal-komagene-giris.jpeg';
import bulvarGorunum from '../assets/images/mahal-komagene-bulvar-gorunum.jpeg';
import dondurmaKosesi from '../assets/images/mahal-komagene-dondurma-kosesi.jpeg';
import dondurmaDolabi from '../assets/images/mahal-komagene-dondurma-dolabi.jpeg';
import mezeTezgahi from '../assets/images/mahal-komagene-meze-tezgahi.jpeg';
import icMekanTezgah from '../assets/images/mahal-komagene-ic-mekan-tezgah.jpeg';

// yerlesim: genis = 2 sütun yatay, uzun = dikey
const ham: { src: ImageMetadata; alt: string; etiket: string; yerlesim: string; pos?: string }[] = [
  { src: disCephe, alt: 'Mahal Komagene İldem şubesinin Alparslan Türkeş Bulvarı üzerindeki dış görünümü', etiket: 'Dış cephe', yerlesim: 'genis' },
  { src: dondurmaKosesi, alt: 'Neon Dondurma tabelalı girişin akşam görünümü', etiket: 'Dondurma köşesi', yerlesim: 'uzun' },
  { src: mezeTezgahi, alt: 'Taze garnitürlerle hazırlanmış self servis çiğ köfte ve meze tezgahı', etiket: 'Tezgah', yerlesim: 'genis' },
  { src: disCepheKose, alt: 'Dükkanın köşeden akşam görünümü', etiket: 'Köşe', yerlesim: 'uzun' },
  { src: dondurmaDolabi, alt: 'Dondurma köşesindeki dolaplarda dondurma çeşitleri', etiket: 'Dondurma dolabı', yerlesim: 'uzun' },
  { src: bulvarGorunum, alt: "Mahal Komagene'nin bulvar tarafından görünümü", etiket: 'Bulvar', yerlesim: 'uzun' },
  { src: icMekanTezgah, alt: 'Tezgah ve menü panolarıyla iç mekan', etiket: 'İç mekan', yerlesim: 'genis' },
  { src: giris, alt: 'Girişin bayraklı akşam görünümü', etiket: 'Giriş', yerlesim: 'uzun' },
  { src: aksamGorunum, alt: 'Dükkanın geniş açıdan akşam görünümü', etiket: 'Akşam', yerlesim: 'genis', pos: '50% 86%' },
];

const fotograflar = await Promise.all(
  ham.map(async (f) => ({
    ...f,
    buyuk: (await getImage({ src: f.src, width: Math.min(1800, f.src.width), format: 'webp', quality: 80 })).src,
  })),
);
const toplam = String(fotograflar.length).padStart(2, '0');
---

<BaseLayout
  title="Galeri | Mahal Komagene – İldem, Kayseri"
  description="Mahal Komagene İldem şubesinden gerçek fotoğraflar: dış cephe, dondurma köşesi, self servis çiğ köfte tezgahı ve iç mekan."
>
  <PageHead
    etiket="Galeri"
    no={`${toplam} kare`}
    lead="Tüm fotoğraflar İldem, Gesi Fatih Mahallesi'ndeki dükkanımızda çekilmiştir."
  >
    <Fragment slot="baslik">Dükkandan{' '}<br /><span class="vurgu">gerçek kareler</span></Fragment>
  </PageHead>

  <section class="kap galeri-bolum" aria-label="Fotoğraflar">
    <ul class="galeri">
      {
        fotograflar.map((f, i) => (
          <li class={f.yerlesim}>
            <a
              href={f.buyuk}
              class="galeri-link"
              data-lightbox
              data-alt={f.alt}
              data-etiket={`${String(i + 1).padStart(2, '0')} / ${toplam} · ${f.etiket}`}
              aria-label={`${f.alt} — büyük boy aç`}
            >
              <figure class="kadraj" data-reveal="perde" style={`--d:${i % 3}`}>
                <Picture
                  src={f.src}
                  widths={[420, 640, 900, 1200, 1600]}
                  sizes={
                    f.yerlesim === 'genis'
                      ? '(min-width: 1000px) 62vw, 92vw'
                      : '(min-width: 1000px) 30vw, (min-width: 640px) 46vw, 92vw'
                  }
                  formats={['avif', 'webp']}
                  width={1200}
                  alt={f.alt}
                  loading={i < 2 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : 'auto'}
                  style={f.pos ? `object-position:${f.pos}` : undefined}
                />
                <figcaption class="kadraj-etiket">
                  <b>{String(i + 1).padStart(2, '0')}</b> {f.etiket}
                </figcaption>
              </figure>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <dialog class="isik-kutusu" data-lightbox-dialog aria-label="Fotoğraf">
    <form method="dialog" class="isik-ust">
      <span class="kunye" data-lightbox-etiket aria-live="polite" aria-atomic="true"></span>
      <button class="isik-kapat kunye" value="kapat" aria-label="Kapat">Kapat ✕</button>
    </form>
    <div class="isik-alt">
      <button class="isik-ok kunye" type="button" data-lightbox-onceki aria-label="Önceki fotoğraf">← Önceki</button>
      <button class="isik-ok kunye" type="button" data-lightbox-sonraki aria-label="Sonraki fotoğraf">Sonraki →</button>
    </div>
  </dialog>
</BaseLayout>

<style>
  .galeri-bolum {
    padding-bottom: clamp(4rem, 9vw, 7rem);
  }
  .galeri {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(0.75rem, 1.6vw, 1.25rem);
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .galeri {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-flow: dense;
    }
    .galeri .genis {
      grid-column: span 2;
    }
  }
  @media (min-width: 640px) and (max-width: 999px) {
    .galeri li:nth-child(8) {
      grid-column: span 2;
    }
    .galeri li:nth-child(8) .kadraj {
      aspect-ratio: 16 / 10;
    }
  }
  @media (min-width: 1000px) {
    .galeri {
      grid-template-columns: repeat(3, 1fr);
      grid-auto-flow: dense;
    }
    .galeri .genis {
      grid-column: span 2;
    }
    .galeri .uzun {
      grid-row: span 2;
    }
  }
  .galeri-link {
    display: block;
    height: 100%;
    cursor: zoom-in;
  }
  .galeri .kadraj {
    height: 100%;
  }
  .galeri .uzun .kadraj {
    aspect-ratio: 3 / 4;
  }
  .galeri .genis .kadraj {
    aspect-ratio: 16 / 10;
  }
  @media (min-width: 1000px) {
    .galeri .uzun .kadraj,
    .galeri .genis .kadraj {
      aspect-ratio: auto;
      min-height: 100%;
    }
    .galeri {
      grid-auto-rows: clamp(220px, 21vw, 330px);
    }
  }
  .galeri .kadraj :global(img) {
    transition: transform 1.2s var(--ease-cine);
  }
  @media (hover: hover) {
    .galeri-link:hover :global(img) {
      transform: scale(1.04);
    }
  }

  /* ── ışık kutusu ── */
  .isik-kutusu {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(7 8 11 / 0.97);
    color: #f2ebe0;
    display: none;
    grid-template-rows: auto 1fr auto;
  }
  .isik-kutusu[open] {
    display: grid;
  }
  .isik-kutusu::backdrop {
    background: rgb(7 8 11 / 0.9);
  }
  .isik-kutusu .kunye {
    color: #f2ebe0;
  }
  .isik-ust,
  .isik-alt {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1rem var(--gutter);
  }
  .isik-kutusu :global(img) {
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: contain;
    padding-inline: var(--gutter);
  }
  .isik-kapat,
  .isik-ok {
    min-height: 44px;
    padding: 0 0.9rem;
    background: none;
    border: 1px solid rgb(242 235 224 / 0.4);
    cursor: pointer;
  }
  .isik-kapat:hover,
  .isik-ok:hover {
    border-color: #f2ebe0;
  }
</style>
