---
import BaseLayout from '../layouts/BaseLayout.astro';
import LocationSection from '../components/LocationSection.astro';
import OpenStatus from '../components/OpenStatus.astro';
import { business } from '../config/business';
---

<BaseLayout
  title="Konum & İletişim | Mahal Komagene – Gesi Fatih Mah., Melikgazi"
  description="Mahal Komagene adres ve iletişim: Alparslan Türkeş Blv. 31/3D, Gesi Fatih Mahallesi, Melikgazi / Kayseri. Telefon, çalışma saatleri, harita ve yol tarifi."
>
  <LocationSection baslikSeviye="h1" no="Konum & İletişim" />

  <section class="bolum-sik kap ulasim" aria-labelledby="ulasim-baslik">
    <div class="serit">
      <span class="kunye">Ulaşım</span>
      <span class="kunye">{business.address.district} · {business.address.city}</span>
    </div>
    <div class="ulasim-ust">
      <h2 id="ulasim-baslik" class="d-l" data-reveal>Nasıl{' '}<br /><span class="vurgu">gelinir?</span></h2>
      <p class="lead" data-reveal style="--d:1">
        Dükkanımız İldem'de, Gesi Fatih Mahallesi sınırları içinde, Alparslan
        Türkeş Bulvarı üzerinde yer alıyor. Bulvar üzerinde olduğumuz için araçla
        gelmek kolay; navigasyona aşağıdaki koordinatları yazabilirsiniz.
      </p>
    </div>

    <div class="ulasim-izgara">
      <article class="ulasim-kart" data-reveal>
        <h3 class="kunye"><b>01</b> Koordinatlar</h3>
        <p class="ulasim-deger kod">{business.geo.latitude}, {business.geo.longitude}</p>
        <a
          class="ulink"
          href={business.maps.viewUrl}
          target="_blank"
          rel="noopener"
          data-olay="click_directions"
        >
          Haritada görüntüle <span class="ok" aria-hidden="true">↗</span>
        </a>
      </article>
      <article class="ulasim-kart" data-reveal style="--d:1">
        <h3 class="kunye"><b>02</b> Telefonla sorun</h3>
        <p class="ulasim-deger">
          <a href={business.phone.href} data-olay="click_call">{business.phone.display}</a>
        </p>
        <p>Yolu tarif edelim ya da ürün sorularınızı yanıtlayalım.</p>
      </article>
      <article class="ulasim-kart" data-reveal style="--d:2">
        <h3 class="kunye"><b>03</b> Çalışma saatleri</h3>
        <p class="ulasim-deger">{business.openingHours.display}</p>
        <p>Gece {business.openingHours.closes.replace(':', '.')}'ye kadar açığız.</p>
        <OpenStatus yedek={false} />
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .ulasim {
    padding-top: 0;
    padding-bottom: clamp(4rem, 9vw, 7rem);
  }
  .ulasim-ust {
    display: grid;
    gap: 1.5rem;
    padding-block: clamp(1.5rem, 4vw, 3rem) clamp(2.5rem, 5vw, 3.5rem);
  }
  @media (min-width: 1000px) {
    .ulasim-ust {
      grid-template-columns: 1.4fr 1fr;
      align-items: end;
    }
  }
  .ulasim-izgara {
    display: grid;
    border-top: 1px solid var(--line);
  }
  @media (min-width: 900px) {
    .ulasim-izgara {
      grid-template-columns: repeat(3, 1fr);
    }
    .ulasim-kart + .ulasim-kart {
      border-left: 1px solid var(--line);
      padding-left: clamp(1.25rem, 2.5vw, 2rem);
    }
  }
  .ulasim-kart {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 0.85rem;
    padding: 1.75rem 1.25rem 1.75rem 0;
    border-bottom: 1px solid var(--line);
  }
  .ulasim-deger {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(1.7rem, 2.8vw, 2.3rem);
    line-height: 1.08;
    text-transform: uppercase;
    letter-spacing: 0;
  }
  .ulasim-deger.kod {
    font-family: var(--mono);
    font-size: clamp(1.05rem, 1.6vw, 1.3rem);
    font-weight: 500;
    letter-spacing: 0.04em;
  }
  .ulasim-deger a {
    text-decoration: none;
  }
  .ulasim-deger a:hover {
    color: var(--ember);
  }
  .ulasim-kart h3.kunye {
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    line-height: 1.4;
  }
  .ulasim-kart p:not(.ulasim-deger) {
    color: var(--fg-dim);
  }
</style>
