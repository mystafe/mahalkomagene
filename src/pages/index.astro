---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArtPicture from '../components/ArtPicture.astro';
import Marquee from '../components/Marquee.astro';
import OpenStatus from '../components/OpenStatus.astro';
import LocationSection from '../components/LocationSection.astro';
import { business } from '../config/business';

import disCephe from '../assets/images/mahal-komagene-dis-cephe.jpeg';
import disCepheKose from '../assets/images/mahal-komagene-dis-cephe-kose.jpeg';
import mezeTezgahi from '../assets/images/mahal-komagene-meze-tezgahi.jpeg';
import icMekanTezgah from '../assets/images/mahal-komagene-ic-mekan-tezgah.jpeg';
import dondurmaDolabi from '../assets/images/mahal-komagene-dondurma-dolabi.jpeg';
import dondurmaKosesi from '../assets/images/mahal-komagene-dondurma-kosesi.jpeg';
import giris from '../assets/images/mahal-komagene-giris.jpeg';
import aksamGorunum from '../assets/images/mahal-komagene-aksam-gorunum.jpeg';
import bulvarGorunum from '../assets/images/mahal-komagene-bulvar-gorunum.jpeg';

const saat = business.openingHours;
const [acilis, kapanis] = [saat.opens.replace(':', '.'), saat.closes.replace(':', '.')];

const tezgah = [
  {
    id: 'cig-kofte',
    ad: 'Çiğ Köfte',
    metin: 'Self servis tezgahımızda taze yeşillik ve soslarla; porsiyonunuzu istediğiniz gibi hazırlatın.',
    gorsel: mezeTezgahi,
    alt: "Mahal Komagene'nin taze malzemelerle hazırlanmış self servis çiğ köfte tezgahı",
    etiket: 'Tezgah · Self servis',
  },
  {
    id: 'meze',
    ad: 'Meze',
    metin: 'Tezgahımızda günlük hazırlanan meze çeşitleri. Çiğ köftenin yanına ya da tek başına.',
    gorsel: icMekanTezgah,
    alt: 'Mahal Komagene tezgahında sıralanmış meze çeşitleri ve taze garnitürler',
    etiket: 'Tezgah · Meze',
  },
  {
    id: 'tatli',
    ad: 'Tatlı',
    metin: 'Tatlı çeşitlerimiz tezgahımızda. Güncel çeşitler için uğrayın ya da telefonla sorun.',
    gorsel: null,
    alt: '',
    etiket: 'Tezgah · Tatlı',
  },
  {
    id: 'dondurma',
    ad: 'Dondurma',
    metin: 'Neon tabelalı dondurma köşemizde dolap boyu çeşit. Gece geç saatte de dondurma alabilirsiniz.',
    gorsel: dondurmaDolabi,
    alt: "Mahal Komagene'nin neon Dondurma tabelalı köşesinde dondurma dolapları",
    etiket: 'Köşe · Dondurma',
  },
];

const kareler = [
  { src: disCepheKose, alt: 'Mahal Komagene İldem şubesinin köşeden akşam görünümü', etiket: 'Dış cephe' },
  { src: icMekanTezgah, alt: 'Menü panoları ve paket dolaplarıyla tezgahın arkası', etiket: 'İç mekan' },
  { src: giris, alt: 'Mahal Komagene girişinin bayraklı akşam görünümü', etiket: 'Giriş' },
  { src: bulvarGorunum, alt: "Mahal Komagene'nin bulvar tarafından görünümü", etiket: 'Bulvar' },
];
---

<BaseLayout
  title="Mahal Komagene | İldem Çiğ Köfte – Melikgazi, Kayseri"
  description="Mahal Komagene, Kayseri İldem'de çiğ köftenin adresi. Gesi Fatih Mahallesi, Alparslan Türkeş Bulvarı üzerindeyiz. Adres, telefon, çalışma saatleri ve yol tarifi."
  heroUstunde
>
  <!-- ═══ KAHRAMAN ═══ -->
  <section class="hero koyu-alan" aria-labelledby="hero-baslik">
    <div class="hero-foto">
      <ArtPicture
        dar={disCepheKose}
        genis={disCephe}
        alt="Mahal Komagene İldem şubesinin Alparslan Türkeş Bulvarı üzerindeki dış görünümü, mavi saatte aydınlatılmış cephesiyle"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="hero-perde" aria-hidden="true"></div>

    <div class="hero-ic kap">
      <dl class="hero-kunye" aria-label="Kısaca">
        <div><dt>Konum</dt><dd>İldem · Gesi Fatih</dd></div>
        <div><dt>Saat</dt><dd>{acilis} → {kapanis}</dd></div>
        <div><dt>Tezgah</dt><dd>Self servis çiğ köfte</dd></div>
        <div><dt>Adres</dt><dd>Alparslan Türkeş Blv.</dd></div>
        <div><dt>Gün</dt><dd>Her gün açık</dd></div>
      </dl>

      <div class="hero-alt">
        <p class="kunye hero-ust-satir">
          <span class="hero-nokta" aria-hidden="true"></span>
          {business.name} · {business.address.district} / {business.address.city}
        </p>
        <h1 id="hero-baslik" class="hero-baslik">
          <span class="satir-maske"><span>İldem'de</span></span>{' '}
          <span class="satir-maske"><span>Çiğ Köfte<span class="vurgu">.</span></span></span>
        </h1>

        <div class="hero-alt-izgara">
          <p class="hero-lead">
            Mahal Komagene, İldem Gesi Fatih Mahallesi'nde çiğ köftenin adresi.
            Alparslan Türkeş Bulvarı üzerindeyiz; çiğ köftenin yanında meze, tatlı
            ve dondurma da bulabilirsiniz. Her gün {acilis}'den gece {kapanis}'ye kadar açığız.
          </p>
          <div class="hero-eylem">
            <div class="hero-dugmeler">
              <a
                href={business.maps.directionsUrl}
                target="_blank"
                rel="noopener"
                class="btn btn-vurgu"
                data-olay="click_directions"
              >
                Yol tarifi al <span class="ok" aria-hidden="true">↗</span>
              </a>
              <a href={business.phone.href} class="btn" data-olay="click_call">Hemen ara</a>
              <a href="/urunler" class="btn hero-urun" data-olay="click_menu">Ürünler</a>
            </div>
            <OpenStatus />
          </div>
        </div>
      </div>
    </div>

    <div class="hero-koordinat kunye" aria-hidden="true">
      <span>{business.geo.latitude}° K</span>
      <span>{business.geo.longitude}° D</span>
    </div>
  </section>

  <Marquee
    ozet="Çiğ köfte, meze, tatlı ve dondurma — her gün 11.00 ile 02.00 arası, Alparslan Türkeş Bulvarı, İldem."
    ogeler={['Çiğ köfte', 'Meze', 'Tatlı', 'Dondurma', `Her gün ${acilis} – ${kapanis}`, 'Alparslan Türkeş Blv.', 'İldem · Kayseri']}
  />

  <!-- ═══ 01 · MAHALLE ═══ -->
  <section class="bolum tanitim" aria-labelledby="tanitim-baslik">
    <div class="kap">
      <div class="serit">
        <span class="kunye">Mahal Komagene</span>
        <span class="kunye">01</span>
      </div>

      <div class="tanitim-izgara">
        <div class="tanitim-metin">
          <h2 id="tanitim-baslik" class="d-l" data-reveal>
            Mahallenin{' '}<br /><span class="vurgu">çiğ köftecisi.</span>
          </h2>
          <p class="tanitim-buyuk" data-reveal style="--d:1">
            Melikgazi'nin İldem bölgesinde, Gesi Fatih Mahallesi'nde bir çiğ köfte
            ve dondurma noktası. Gündüz de gece de uğrayabileceğiniz bir yer olmayı
            amaçlıyoruz.
          </p>
          <p class="lead" data-reveal style="--d:2">
            Çiğ köftenin yanında meze, tatlı ve dondurma çeşitlerimizle
            Alparslan Türkeş Bulvarı üzerindeyiz; İldem'deyseniz bize uğrayın.
          </p>
          <a href="/hakkimizda" class="tanitim-link kunye" data-reveal style="--d:3">
            Hakkımızda daha fazlası <span class="ok ok-sag" aria-hidden="true">→</span>
          </a>
        </div>

        <div class="tanitim-gorseller">
          <figure class="kadraj tanitim-g1" data-reveal="perde">
            <Picture
              src={aksamGorunum}
              widths={[480, 720, 1000]}
              sizes="(min-width: 1000px) 30vw, 70vw"
              formats={['avif', 'webp']}
              width={1200}
              alt="Mahal Komagene'nin akşam saatlerinde geniş açıdan görünümü"
              loading="lazy"
            />
            <figcaption class="kadraj-etiket"><b>Kare</b> Akşam</figcaption>
          </figure>
          <figure class="kadraj tanitim-g2" data-reveal="perde" style="--d:2">
            <Picture
              src={mezeTezgahi}
              widths={[400, 640, 860]}
              sizes="(min-width: 1000px) 20vw, 50vw"
              formats={['avif', 'webp']}
              width={1200}
              alt="Self servis tezgahta limon, domates ve yeşilliklerle dolu çiğ köfte garnitürleri"
              loading="lazy"
            />
            <figcaption class="kadraj-etiket"><b>Kare</b> Tezgah</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ 02 · TEZGAH ═══ -->
  <section class="bolum tezgah" aria-labelledby="tezgah-baslik" data-tezgah>
    <div class="kap">
      <div class="serit">
        <span class="kunye">Ürünler · Tezgah</span>
        <span class="kunye">02</span>
      </div>

      <div class="tezgah-izgara">
        <div class="tezgah-sol">
          <div class="tezgah-yapiskan">
            <h2 id="tezgah-baslik" class="d-l">Tezgahta{' '}<br />neler var?</h2>
            <p class="lead">
              Çiğ köfteden dondurmaya dört ana kategori; hepsi bir arada, tek durakta.
            </p>
            <ol class="tezgah-liste" aria-label="Kategoriler">
              {
                tezgah.map((t, i) => (
                  <li>
                    <a href={`#${t.id}`} data-tezgah-link data-etkin={i === 0 ? '' : undefined}>
                      <span class="kunye">{String(i + 1).padStart(2, '0')}</span>
                      <span class="tezgah-ad">{t.ad}</span>
                    </a>
                  </li>
                ))
              }
            </ol>
            <div class="tezgah-alt">
              <span class="kunye"><span data-tezgah-sayac>01</span> / 04</span>
              <a href="/urunler" class="btn" data-olay="click_menu">
                Tüm ürünler <span class="ok ok-sag" aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </div>

        <div class="tezgah-sag">
          {
            tezgah.map((t, i) => (
              <article class="panel" id={t.id} data-tezgah-panel aria-labelledby={`${t.id}-ad`}>
                {t.gorsel ? (
                  <figure class="kadraj panel-gorsel" data-reveal="perde">
                    <Picture
                      src={t.gorsel}
                      widths={[480, 720, 1000, 1400]}
                      sizes="(min-width: 1000px) 52vw, 92vw"
                      formats={['avif', 'webp']}
                      width={1200}
                      alt={t.alt}
                      loading="lazy"
                    />
                    <figcaption class="kadraj-etiket">
                      <b>{String(i + 1).padStart(2, '0')}</b> {t.etiket}
                    </figcaption>
                  </figure>
                ) : (
                  <div class="panel-gorsel panel-bos" data-reveal="perde">
                    <span class="panel-bos-yazi display" aria-hidden="true">Tatlı</span>
                    <span class="kunye panel-bos-not">Tezgah · Tatlı</span>
                  </div>
                )}
                <div class="panel-metin">
                  <h3 id={`${t.id}-ad`}>
                    <span class="kunye">{String(i + 1).padStart(2, '0')}</span> {t.ad}
                  </h3>
                  <p>
                    {t.id === 'tatli' ? (
                      <>
                        Tatlı çeşitlerimiz tezgahımızda. Güncel çeşitler için uğrayın ya da{' '}
                        <a class="ulink" href={business.phone.href} data-olay="click_call">telefonla sorun</a>.
                      </>
                    ) : (
                      t.metin
                    )}
                  </p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ 03 · GECE ═══ -->
  <section class="gece" aria-labelledby="gece-baslik">
    <figure class="gece-foto">
      <Picture
        src={dondurmaKosesi}
        widths={[600, 900, 1300, 1536]}
        sizes="(min-width: 1000px) 50vw, 100vw"
        formats={['avif', 'webp']}
        width={1200}
        alt="Neon Dondurma tabelası altında dondurma dolaplarıyla Mahal Komagene'nin dondurma köşesi"
        loading="lazy"
      />
    </figure>
    <div class="gece-metin">
      <div class="serit">
        <span class="kunye">Gece de açık</span>
        <span class="kunye">03</span>
      </div>
      <h2 id="gece-baslik" class="d-l" data-reveal>
        Gece{' '}<br />{kapanis}'ye{' '}<br /><span class="vurgu">kadar açığız.</span>
      </h2>
      <p class="lead" data-reveal style="--d:1">
        Gündüz yemek arası, gece tatlı ya da dondurma — ne zaman yolunuz düşerse
        bekleriz. Neon tabelalı dondurma köşemiz özellikle yaz akşamlarının uğrak
        noktası.
      </p>
      <div class="saat-blok" data-reveal style="--d:2">
        <div>
          <span class="kunye">Açılış</span>
          <span class="saat-rakam">{acilis}</span>
        </div>
        <span class="saat-ok" aria-hidden="true">→</span>
        <div>
          <span class="kunye">Kapanış</span>
          <span class="saat-rakam">{kapanis}</span>
        </div>
      </div>
      <p class="gece-durum" data-reveal style="--d:3">
        <span class="kunye">Her gün açık</span>
        <OpenStatus yedek={false} />
      </p>
    </div>
  </section>

  <!-- ═══ 04 · KARELER ═══ -->
  <section class="bolum kareler" aria-labelledby="kareler-baslik">
    <div class="kap">
      <div class="serit">
        <span class="kunye">Galeri</span>
        <span class="kunye">04</span>
      </div>
      <div class="kareler-ust">
        <h2 id="kareler-baslik" class="d-l" data-reveal>Dükkandan{' '}<br />kareler</h2>
        <div class="kareler-ust-sag" data-reveal style="--d:1">
          <p class="lead">Dış cephe, tezgah ve dondurma köşemizden gerçek fotoğraflar.</p>
          <a href="/galeri" class="btn">
            Galerinin tamamı <span class="ok ok-sag" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>

    <ul class="serit-film" aria-label="Fotoğraflar" tabindex="0">
      {
        kareler.map((k, i) => (
          <li>
            <figure class="kadraj film-kare">
              <Picture
                src={k.src}
                widths={[400, 640, 900]}
                sizes="(min-width: 1000px) 28vw, 74vw"
                formats={['avif', 'webp']}
                width={1200}
                alt={k.alt}
                loading="lazy"
              />
              <figcaption class="kadraj-etiket">
                <b>{String(i + 1).padStart(2, '0')}</b> {k.etiket}
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ═══ 05 · KONUM ═══ -->
  <LocationSection no="05" />
</BaseLayout>

<style>
  /* ═══ KAHRAMAN ═══ */
  .hero {
    position: relative;
    min-height: var(--hero-h);
    display: flex;
    isolation: isolate;
    overflow: hidden;
  }
  .hero-foto {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .hero-foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 35%;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-foto :global(img) {
      animation: yakinlas 2.4s var(--ease-cine) both;
    }
  }
  @keyframes yakinlas {
    from {
      transform: scale(1.08);
      opacity: 0.4;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }
  .hero-perde {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--hero-shade);
  }
  @media (min-width: 800px) {
    .hero-perde {
      background: var(--hero-shade), var(--hero-shade-side);
    }
  }
  @media (max-width: 799px) {
    .hero-perde {
      background:
        linear-gradient(to bottom, rgb(var(--bg-rgb) / 0.75) 0, rgb(var(--bg-rgb) / 0) 16%),
        linear-gradient(to top, rgb(var(--bg-rgb) / 1) 0, rgb(var(--bg-rgb) / 0.9) 36%, rgb(var(--bg-rgb) / 0.62) 56%, rgb(var(--bg-rgb) / 0) 76%);
    }
    .hero-ust-satir {
      width: max-content;
      max-width: 100%;
      padding: 0.3rem 0.55rem;
      background: var(--chip);
    }
  }
  @media (max-width: 767px) {
    .hero .hero-ic {
      padding-bottom: calc(var(--mobil-bar) + env(safe-area-inset-bottom) + 1.25rem);
    }
  }

  /* GÜNDÜZ: giriş yine koyu kalır ama perde hafifler; fotoğraf daha aydınlık görünür,
     koyuluk yalnız yazının arkasında toplanır (gece ile eski krem perde arası). */
  :global(:root[data-theme='light']) .hero {
    --hero-shade:
      linear-gradient(to bottom, rgb(var(--bg-rgb) / 0.32) 0, rgb(var(--bg-rgb) / 0) 12%),
      linear-gradient(to top, rgb(var(--bg-rgb) / 0.88) 0, rgb(var(--bg-rgb) / 0.58) 20%, rgb(var(--bg-rgb) / 0.16) 42%, rgb(var(--bg-rgb) / 0) 54%);
    --hero-shade-side: linear-gradient(to right, rgb(var(--bg-rgb) / 0.5) 0, rgb(var(--bg-rgb) / 0.2) 28%, rgb(var(--bg-rgb) / 0) 44%);
  }
  :global(:root[data-theme='light']) .hero-foto :global(img) {
    filter: brightness(1.24) saturate(1.08);
  }
  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme='dark'])) .hero {
      --hero-shade:
        linear-gradient(to bottom, rgb(var(--bg-rgb) / 0.32) 0, rgb(var(--bg-rgb) / 0) 12%),
        linear-gradient(to top, rgb(var(--bg-rgb) / 0.88) 0, rgb(var(--bg-rgb) / 0.58) 20%, rgb(var(--bg-rgb) / 0.16) 42%, rgb(var(--bg-rgb) / 0) 54%);
      --hero-shade-side: linear-gradient(to right, rgb(var(--bg-rgb) / 0.5) 0, rgb(var(--bg-rgb) / 0.2) 28%, rgb(var(--bg-rgb) / 0) 44%);
    }
    :global(:root:not([data-theme='dark'])) .hero-foto :global(img) {
      filter: brightness(1.24) saturate(1.08);
    }
  }
  @media (max-width: 799px) {
    :global(:root[data-theme='light']) .hero-perde {
      background:
        linear-gradient(to bottom, rgb(var(--bg-rgb) / 0.32) 0, rgb(var(--bg-rgb) / 0) 12%),
        linear-gradient(to top, rgb(var(--bg-rgb) / 0.92) 0, rgb(var(--bg-rgb) / 0.7) 32%, rgb(var(--bg-rgb) / 0.28) 52%, rgb(var(--bg-rgb) / 0) 68%);
    }
  }
  @media (max-width: 799px) and (prefers-color-scheme: light) {
    :global(:root:not([data-theme='dark'])) .hero-perde {
      background:
        linear-gradient(to bottom, rgb(var(--bg-rgb) / 0.32) 0, rgb(var(--bg-rgb) / 0) 12%),
        linear-gradient(to top, rgb(var(--bg-rgb) / 0.92) 0, rgb(var(--bg-rgb) / 0.7) 32%, rgb(var(--bg-rgb) / 0.28) 52%, rgb(var(--bg-rgb) / 0) 68%);
    }
  }

  .hero-ic {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    padding-top: calc(var(--hdr-h) + clamp(1.25rem, 4vw, 2.5rem));
    padding-bottom: clamp(1.75rem, 5vw, 3.5rem);
  }

  /* künye kutusu: sol üstte, VibeX sahne künyesi gibi */
  .hero-kunye {
    display: none;
    align-self: flex-start;
    gap: 0.35rem;
  }
  .hero-kunye div {
    display: flex;
    gap: 0.6rem;
    width: max-content;
    padding: 0.32rem 0.55rem;
    background: var(--chip);
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .hero-kunye dt {
    color: var(--ember);
    min-width: 4.4em;
  }
  .hero-kunye dd {
    color: var(--fg);
  }
  @media (min-width: 800px) {
    .hero-kunye {
      display: grid;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-kunye div {
      animation: kunye-gel 0.8s var(--ease-cine) both;
    }
    .hero-kunye div:nth-child(1) { animation-delay: 0.5s; }
    .hero-kunye div:nth-child(2) { animation-delay: 0.6s; }
    .hero-kunye div:nth-child(3) { animation-delay: 0.7s; }
    .hero-kunye div:nth-child(4) { animation-delay: 0.8s; }
    .hero-kunye div:nth-child(5) { animation-delay: 0.9s; }
  }
  @keyframes kunye-gel {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  .hero-alt {
    margin-top: auto;
  }
  .hero-ust-satir {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--fg);
    margin-bottom: 1rem;
  }
  .hero-nokta {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ember);
  }
  .hero-baslik {
    font-size: clamp(3.4rem, min(12vw, 17svh), 11.5rem);
    line-height: 1.08;
    margin-bottom: clamp(1.25rem, 3vw, 2rem);
    margin-left: -0.04em;
  }
