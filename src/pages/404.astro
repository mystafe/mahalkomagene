---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business } from '../config/business';
---

<BaseLayout
  title="Sayfa Bulunamadı | Mahal Komagene"
  description="Aradığınız sayfa bulunamadı. Mahal Komagene ana sayfasına dönün veya konum ve iletişim bilgilerimize göz atın."
  noindex
>
  <section class="yok kap">
    <div class="serit">
      <span class="kunye">Hata · 404</span>
      <span class="kunye">{business.geo.latitude}° K · {business.geo.longitude}° D</span>
    </div>
    <p class="yok-kod display" aria-hidden="true">404</p>
    <h1 class="yok-baslik">Bu sayfa yok,{' '}<br /><span class="vurgu">ama biz buradayız.</span></h1>
    <p class="lead">
      Aradığınız sayfa taşınmış ya da hiç var olmamış olabilir. Dükkan yerinde
      duruyor: {business.address.full}
    </p>
    <div class="yok-dugmeler">
      <a href="/" class="btn btn-vurgu">Ana sayfaya dön</a>
      <a href="/konum-iletisim" class="btn">Konum &amp; İletişim</a>
    </div>
  </section>
</BaseLayout>

<style>
  .yok {
    display: grid;
    gap: 1.75rem;
    justify-items: start;
    padding-top: calc(var(--hdr-h) + clamp(2rem, 6vw, 4rem));
    padding-bottom: clamp(4rem, 10vw, 8rem);
  }
  .yok .serit {
    width: 100%;
  }
  .yok-kod {
    font-size: clamp(9rem, 34vw, 30rem);
    line-height: 0.9;
    color: transparent;
    -webkit-text-stroke: 1px var(--line-strong);
    margin-block: -0.05em -0.15em;
  }
  .yok-baslik {
    font-size: clamp(2.6rem, 7vw, 6rem);
  }
  .yok-dugmeler {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
