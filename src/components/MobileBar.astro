---
import { business } from '../config/business';
---

<!-- Mobil yapışkan eylem çubuğu: Ara / Yol Tarifi / Ürünler -->
<nav class="mobil-bar" aria-label="Hızlı işlemler">
  <a href={business.phone.href} class="mobil-eylem" data-olay="click_call">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z"/></svg>
    <span>Ara</span>
  </a>
  <a
    href={business.maps.directionsUrl}
    target="_blank"
    rel="noopener"
    class="mobil-eylem mobil-eylem-ana"
    data-olay="click_directions"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 21s-7-6.2-7-12a7 7 0 0 1 14 0c0 5.8-7 12-7 12Z"/><circle cx="12" cy="9" r="2.5"/></svg>
    <span>Yol tarifi</span>
  </a>
  <a href="/urunler" class="mobil-eylem" data-olay="click_menu">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10"/></svg>
    <span>Ürünler</span>
  </a>
</nav>

<style>
  .mobil-bar {
    display: none;
  }

  @media (max-width: 767px) {
    .mobil-bar {
      position: fixed;
      inset: auto 0 0;
      z-index: 180;
      display: grid;
      grid-template-columns: 1fr 1.25fr 1fr;
      height: calc(var(--mobil-bar) + env(safe-area-inset-bottom));
      padding-bottom: env(safe-area-inset-bottom);
      background: rgb(var(--bg-rgb) / 0.96);
      border-top: 1px solid var(--line);
    }
    :global(html[data-menu-acik]) .mobil-bar {
      visibility: hidden;
    }
    .mobil-eylem {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.3rem;
      color: var(--fg);
      text-decoration: none;
      font-family: var(--mono);
      font-size: 0.66rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      -webkit-tap-highlight-color: transparent;
    }
    .mobil-eylem + .mobil-eylem {
      border-left: 1px solid var(--line);
    }
    .mobil-eylem-ana {
      background: var(--ember);
      color: var(--ember-ink);
      border-left-color: var(--ember) !important;
    }
    .mobil-eylem-ana + .mobil-eylem {
      border-left-color: var(--ember);
    }
    .mobil-eylem:active {
      opacity: 0.75;
    }
  }
</style>
