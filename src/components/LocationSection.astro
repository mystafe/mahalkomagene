---
import { business } from '../config/business';
import OpenStatus from './OpenStatus.astro';

interface Props {
  /** Sayfada tek H1 kuralı için başlık seviyesi */
  baslikSeviye?: 'h1' | 'h2';
  /** Bölüm numarası (künye) */
  no?: string;
}
const { baslikSeviye = 'h2', no = '04' } = Astro.props;
const Baslik = baslikSeviye;
const ustBosluk = baslikSeviye === 'h1';
---

<section
  class:list={['konum', ustBosluk ? 'konum-sayfa' : 'bolum']}
  id="konum"
  aria-labelledby="konum-baslik"
>
  <div class="kap">
    <div class="serit">
      <span class="kunye">Konum · İldem</span>
      <span class="kunye">{no}</span>
    </div>

    <div class="konum-ust">
      <Baslik id="konum-baslik" class="konum-baslik" data-reveal={ustBosluk ? undefined : ''}>
        Buradayız:{' '}<br /><span class="vurgu">Alparslan Türkeş Bulvarı</span>
      </Baslik>
      <p class="lead" data-reveal style="--d:1">
        İldem, Gesi Fatih Mahallesi'nde Alparslan Türkeş Bulvarı üzerinde hizmet
        veriyoruz. Konumu açın, yol tarifini alın; bulvar üzerinde olduğumuz için
        ulaşım kolay.
      </p>
    </div>

    <div class="konum-izgara">
      <div class="konum-bilgi">
      <dl class="konum-liste">
        <div class="satir">
          <dt class="kunye">Adres</dt>
          <dd>
            {business.address.street}<br />
            {business.address.neighborhood}<br />
            {business.address.postalCode} {business.address.district} / {business.address.city}
          </dd>
        </div>
        <div class="satir">
          <dt class="kunye">Telefon</dt>
          <dd>
            <a class="konum-tel" href={business.phone.href} data-olay="click_call">{business.phone.display}</a>
          </dd>
        </div>
        <div class="satir">
          <dt class="kunye">Çalışma saatleri</dt>
          <dd>
            {business.openingHours.display}
            <OpenStatus class="konum-durum" yedek={false} />
          </dd>
        </div>
      </dl>
        <div class="konum-butonlar">
          <a
            href={business.maps.directionsUrl}
            target="_blank"
            rel="noopener"
            class="btn btn-vurgu"
            data-olay="click_directions"
          >
            Yol tarifi al <span class="ok" aria-hidden="true">↗</span>
          </a>
          <a href={business.phone.href} class="btn" data-olay="click_call">Hemen ara</a>
        </div>
      </div>

      <div class="harita">
        <div class="harita-cerceve">
          <iframe
            src={business.maps.embedUrl}
            title="Mahal Komagene konumu — Google Haritalar"
            loading="lazy"
            allowfullscreen
            referrerpolicy="no-referrer-when-downgrade"></iframe>
          <span class="harita-pin" aria-hidden="true"></span>
        </div>
        <div class="harita-alt">
          <span class="kunye">{business.geo.latitude}° K · {business.geo.longitude}° D</span>
          <a
            href={business.maps.viewUrl}
            target="_blank"
            rel="noopener"
            class="kunye harita-ac"
            data-olay="click_directions"
          >
            Google Haritalar'da aç <span class="ok" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .konum-sayfa {
    padding-top: calc(var(--hdr-h) + clamp(2rem, 6vw, 4rem));
    padding-bottom: clamp(4rem, 9vw, 7rem);
  }

  .konum-ust {
    display: grid;
    gap: 1.5rem;
    padding-block: clamp(1.5rem, 4vw, 3rem) clamp(2.5rem, 6vw, 4.5rem);
  }
  .konum-baslik {
    font-size: clamp(2.6rem, 7.6vw, 6.6rem);
  }
  @media (min-width: 1000px) {
    .konum-ust {
      grid-template-columns: 1.5fr 1fr;
      align-items: end;
    }
  }

  .konum-izgara {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
  }
  @media (min-width: 1000px) {
    .konum-izgara {
      grid-template-columns: 1fr 1.35fr;
    }
  }

  .konum-bilgi {
    display: grid;
    align-content: start;
  }
  .konum-liste {
    margin: 0;
  }
  .satir {
    display: grid;
    grid-template-columns: minmax(7.5rem, 0.6fr) 1fr;
    gap: 1rem;
    padding-block: 1.15rem;
    border-top: 1px solid var(--line);
  }
  .satir dt {
    padding-top: 0.3rem;
  }
  .satir dd {
    display: grid;
    gap: 0.6rem;
    justify-items: start;
    font-size: 1.05rem;
    line-height: 1.55;
  }
  .konum-tel {
    font-family: var(--display);
    font-size: clamp(1.7rem, 3.2vw, 2.3rem);
    line-height: 1;
    text-decoration: none;
    transition: color 0.3s;
  }
  .konum-tel:hover {
    color: var(--ember);
  }
  .konum-butonlar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .harita-cerceve {
    position: relative;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--line-strong);
    background: var(--bg-raise);
    overflow: hidden;
  }
  @media (min-width: 1000px) {
    .harita-cerceve {
      aspect-ratio: auto;
      height: 100%;
      min-height: 460px;
    }
    .harita {
      display: grid;
      grid-template-rows: 1fr auto;
    }
  }
  .harita iframe {
    width: 100%;
    height: 100%;
    border: 0;
    filter: var(--map-filter);
  }
  .harita-alt {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding-top: 0.85rem;
  }
  .harita-ac {
    color: var(--fg);
    text-decoration: none;
  }
  .harita-ac:hover {
    color: var(--ember);
  }
  .harita-pin {
    position: absolute;
    inset: 0;
    pointer-events: none;
    box-shadow: inset 0 0 0 1px rgb(var(--fg-rgb) / 0.05);
  }
</style>
