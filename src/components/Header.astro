---
import { business } from '../config/business';

const yol = Astro.url.pathname.replace(/\/$/, '') || '/';

const linkler = [
  { href: '/', etiket: 'Ana Sayfa' },
  { href: '/urunler', etiket: 'Ürünler' },
  { href: '/galeri', etiket: 'Galeri' },
  { href: '/hakkimizda', etiket: 'Hakkımızda' },
  { href: '/konum-iletisim', etiket: 'Konum & İletişim' },
];
---

<header class="ust-bar">
  <div class="icerik ust-bar-ic">
    <a href="/" class="marka" aria-label="Mahal Komagene ana sayfa">
      <span class="marka-mahal">Mahal</span>
      <span class="marka-komagene">Komagene</span>
    </a>

    <nav aria-label="Ana menü">
      <input type="checkbox" id="menu-ac" class="menu-kutu" aria-hidden="true" />
      <label for="menu-ac" class="menu-dugme" aria-hidden="true">
        <span class="cizgi"></span>
        <span class="cizgi"></span>
        <span class="cizgi"></span>
        <span class="menu-yazi">Menü</span>
      </label>
      <ul class="menu-liste">
        {
          linkler.map((l) => (
            <li>
              <a href={l.href} aria-current={yol === l.href ? 'page' : undefined}>
                {l.etiket}
              </a>
            </li>
          ))
        }
        <li class="menu-ara">
          <a href={business.phone.href} class="btn btn-birincil">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24 11.4 11.4 0 0 0 3.57.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .57 3.57 1 1 0 0 1-.25 1.02Z"/></svg>
            Hemen Ara
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .ust-bar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgb(250 246 239 / 0.92);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--cizgi);
  }

  .ust-bar-ic {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4rem;
    gap: 1rem;
  }

  .marka {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    text-decoration: none;
    line-height: 1;
  }

  .marka-mahal {
    font-weight: 500;
    font-size: 1.25rem;
    letter-spacing: 0.01em;
    color: var(--murekkep);
  }

  .marka-komagene {
    font-weight: 800;
    font-size: 1.25rem;
    letter-spacing: -0.01em;
    color: var(--kirmizi);
  }

  .menu-liste {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .menu-liste a:not(.btn) {
    color: var(--murekkep);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.97rem;
    padding-block: 0.5rem;
  }

  .menu-liste a:not(.btn):hover,
  .menu-liste a[aria-current='page']:not(.btn) {
    color: var(--kirmizi);
  }

  .menu-liste a[aria-current='page']:not(.btn) {
    text-decoration: underline;
    text-underline-offset: 6px;
    text-decoration-thickness: 2px;
  }

  .menu-ara .btn {
    min-height: 2.5rem;
    padding: 0.4rem 1.1rem;
    font-size: 0.92rem;
  }

  .menu-kutu,
  .menu-dugme {
    display: none;
  }

  /* Mobil menü — CSS ile, JavaScript'siz */
  @media (max-width: 55rem) {
    .menu-dugme {
      display: flex;
      align-items: center;
      gap: 0.55rem;
      cursor: pointer;
      padding: 0.6rem 0.2rem 0.6rem 0.6rem;
      -webkit-tap-highlight-color: transparent;
    }

    .menu-dugme .cizgi {
      display: none;
    }

    .menu-yazi {
      font-weight: 700;
      font-size: 0.95rem;
      border: 2px solid var(--murekkep);
      border-radius: 999px;
      padding: 0.35rem 1rem;
    }

    .menu-liste {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: var(--krem);
      border-bottom: 1px solid var(--cizgi);
      box-shadow: var(--golge-buyuk);
      padding: 0.5rem 1.25rem 1.25rem;
    }

    .menu-kutu:checked ~ .menu-liste {
      display: flex;
    }

    .menu-liste li {
      border-bottom: 1px solid var(--cizgi);
    }

    .menu-liste li:last-child {
      border-bottom: none;
    }

    .menu-liste a:not(.btn) {
      display: block;
      padding: 0.9rem 0.25rem;
      font-size: 1.05rem;
    }

    .menu-ara {
      padding-top: 1rem;
    }

    .menu-ara .btn {
      width: 100%;
      min-height: 3rem;
      font-size: 1rem;
    }
  }
</style>
