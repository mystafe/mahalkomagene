---
import { business } from '../config/business';
import OpenStatus from './OpenStatus.astro';
const yil = new Date().getFullYear();
---

<footer class="alt">
  <div class="kap">
    <div class="alt-ust">
      <p class="alt-cagri display">
        İldem'deyseniz{' '}<br /><span class="vurgu">bir uğrayın.</span>
      </p>
      <div class="alt-eylem">
        <a
          href={business.maps.directionsUrl}
          target="_blank"
          rel="noopener"
          class="btn btn-vurgu"
          data-olay="click_directions"
        >
          Yol tarifi al <span class="ok" aria-hidden="true">↗</span>
        </a>
        <a href={business.phone.href} class="btn" data-olay="click_call">
          {business.phone.display}
        </a>
      </div>
    </div>

    <div class="alt-izgara">
      <div class="alt-sutun">
        <h2 class="kunye">Adres</h2>
        <address>
          {business.address.street}<br />
          {business.address.neighborhood}<br />
          {business.address.postalCode} {business.address.district} / {business.address.city}
        </address>
      </div>
      <div class="alt-sutun">
        <h2 class="kunye">Saatler</h2>
        <p>{business.openingHours.display}</p>
        <OpenStatus yedek={false} />
      </div>
      <div class="alt-sutun">
        <h2 class="kunye">İletişim</h2>
        <p>
          <a class="ulink" href={business.phone.href} data-olay="click_call">{business.phone.display}</a>
        </p>
        {
          business.instagramUrl && (
            <p>
              <a
                class="ulink"
                href={business.instagramUrl}
                target="_blank"
                rel="noopener"
                data-olay="click_instagram"
              >
                Instagram
              </a>
            </p>
          )
        }
      </div>
      <nav class="alt-sutun" aria-label="Alt menü">
        <h2 class="kunye">Sayfalar</h2>
        <ul>
          <li><a class="ulink" href="/urunler">Ürünler</a></li>
          <li><a class="ulink" href="/galeri">Galeri</a></li>
          <li><a class="ulink" href="/hakkimizda">Hakkımızda</a></li>
          <li><a class="ulink" href="/konum-iletisim">Konum &amp; İletişim</a></li>
        </ul>
      </nav>
    </div>
  </div>

  <p class="alt-dev display" aria-hidden="true">Mahal Komagene</p>

  <div class="kap alt-telif">
    <p class="kunye">© {yil} {business.name}</p>
    <p class="kunye">{business.locality} · {business.address.district} · {business.address.city}</p>
    <p class="kunye">
      Site:{' '}<a class="alt-imza" href="https://www.mustafaevleksiz.com" target="_blank" rel="noopener">Mustafa Evleksiz</a>
    </p>
  </div>
</footer>

<style>
  .alt {
    position: relative;
    margin-top: 0;
    padding-top: clamp(4rem, 10vw, 7.5rem);
    background: var(--bg-sink);
    border-top: 1px solid var(--line);
    overflow: hidden;
  }

  .alt-ust {
    display: grid;
    gap: 2rem;
    align-items: end;
    padding-bottom: clamp(3rem, 7vw, 5rem);
  }
  .alt-cagri {
    font-size: clamp(2.8rem, 9vw, 7.5rem);
  }
  .alt-eylem {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  @media (min-width: 900px) {
    .alt-ust {
      grid-template-columns: 1.4fr 1fr;
    }
    .alt-eylem {
      justify-content: flex-end;
    }
  }

  .alt-izgara {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }
  @media (min-width: 900px) {
    .alt-izgara {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .alt-sutun {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding: 1.5rem 1rem 1.75rem 0;
    font-size: 0.98rem;
    color: var(--fg-dim);
  }
  .alt-sutun .kunye {
    margin-bottom: 0.4rem;
    color: var(--fg-mute);
    font-size: 0.7rem;
  }
  .alt-sutun address {
    font-style: normal;
  }
  .alt-sutun a {
    color: var(--fg);
  }
  .alt-sutun ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }

  /* dev marka yazısı: alt kenara oturur */
  .alt-dev {
    margin-top: clamp(1.5rem, 5vw, 3rem);
    padding-inline: var(--gutter);
    font-size: clamp(3.2rem, 13.6vw, 13.5rem);
    line-height: 0.78;
    white-space: nowrap;
    text-align: center;
    color: transparent;
    -webkit-text-stroke: 1px var(--line-strong);
    user-select: none;
    transform: translateY(0.08em);
  }

  .alt-telif {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--line);
    position: relative;
    background: var(--bg-sink);
  }
  .alt-telif .kunye {
    font-size: 0.66rem;
  }
  .alt-imza {
    color: inherit;
    text-decoration: none;
    transition: color 0.3s;
  }
  .alt-imza:hover,
  .alt-imza:focus-visible {
    color: var(--fg);
  }
</style>
